# ==========================================
# Central Dogma Simulator Environment Variables
# ==========================================

# Vercel 환경변수: OpenAI API Key (Required for live ChatGPT 4o)
# Vercel Dashboard -> Settings -> Environment Variables 에서 추가하세요.
CHATGPT_API=sk-your-openai-api-key-here

# Supabase 설정 (선택 사항 - 포럼 및 랭킹 DB 연동용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
